{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "projects": {
    "authservice": {
      "type": "application",
      "root": "apps/authservice",
      "entryFile": "main",
      "sourceRoot": "apps/authservice/src",
      "compilerOptions": {
        "assets": [
          {
            "include": "src/grpc/proto/*.proto",
            "outDir": "src/grpc/proto"
          }
        ],
        "tsConfigPath": "apps/authservice/tsconfig.app.json",
        "deleteOutDir": true
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "graphql": {
      "type": "library",
      "root": "libs/graphql",
      "entryFile": "index",
      "sourceRoot": "libs/graphql/src",
      "compilerOptions": {
        "tsConfigPath": "libs/graphql/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    }
  },
  "compilerOptions": {
  }
}